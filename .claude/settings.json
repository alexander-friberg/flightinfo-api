{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(uv run *)",
      "Bash(uv sync)",
      "Bash(uv sync *)",
      "Bash(uv lock)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "WebFetch(domain:apideveloper.swedavia.se)",
      "WebFetch(domain:api.swedavia.se)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:www.python-httpx.org)",
      "WebFetch(domain:docs.pytest.org)",
      "WebFetch(domain:docs.astral.sh)",
      "WebFetch(domain:mypy.readthedocs.io)",
      "WebFetch(domain:docs.github.com)"
    ],
    "ask": [
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(git restore *)",
      "Bash(git checkout *)",
      "Bash(git reset *)",
      "Bash(git stash *)",
      "Bash(rm *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Bash(cat *.env*)",
      "Bash(less *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(grep * .env*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git commit *)",
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/checks.sh",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
